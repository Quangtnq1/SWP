<UserControl x:Class="SWP.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtLoiChao" Style="{StaticResource PageTitle}"/>

        <UniformGrid Columns="4" Rows="1">
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tổng sản phẩm" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtTongSanPham" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Hàng dưới định mức" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtSoHangDuoiDinhMuc" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ColorWarning}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Phiếu nhập chờ duyệt" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtPhieuNhapChoDuyet" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ColorText}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="18" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Phiếu xuất chờ duyệt" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtPhieuXuatChoDuyet" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ColorText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,16,0,0" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tổng giá trị tồn kho hiện tại" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="TxtTongGiaTriTonKho" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ColorSuccess}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Sản phẩm dưới định mức tồn tối thiểu" Style="{StaticResource PageTitle}" FontSize="15" Margin="0,20,0,10"/>
        <DataGrid x:Name="GridDuoiDinhMuc" MaxHeight="260">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="90"/>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Ten}" Width="*"/>
                <DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding TonKho}" Width="100"/>
                <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding TonToiThieu}" Width="100"/>
                <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
