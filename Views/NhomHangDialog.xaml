<Window x:Class="SWP.Views.NhomHangDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhóm hàng" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTieuDe" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Mã nhóm hàng" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtMa" Margin="0,0,0,10"/>

        <TextBlock Text="Tên nhóm hàng" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtTen" Margin="0,0,0,10"/>

        <TextBlock Text="Mô tả" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtMoTa" Margin="0,0,0,16" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnHuy_Click"/>
            <Button Content="Lưu" Style="{StaticResource BtnPrimary}" Width="90" Click="BtnLuu_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
