<UserControl x:Class="SWP.Views.NguoiDungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Quản lý người dùng" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="+ Thêm tài khoản" Style="{StaticResource BtnPrimary}" Width="140" Click="BtnThem_Click"/>
            <Button Content="Sửa" Style="{StaticResource BtnSecondary}" Width="80" Margin="8,0,0,0" Click="BtnSua_Click"/>
            <Button Content="Đặt lại mật khẩu" Style="{StaticResource BtnSecondary}" Width="140" Margin="8,0,0,0" Click="BtnDatLaiMatKhau_Click"/>
            <Button Content="Làm mới" Style="{StaticResource BtnSecondary}" Width="90" Margin="8,0,0,0" Click="BtnLamMoi_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridNguoiDung">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding TenDangNhap}" Width="130"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="180"/>
                <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="100"/>
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="120"/>
                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding DangHoatDong}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
