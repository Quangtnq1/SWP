<UserControl x:Class="SWP.Views.NhomHangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Nhóm hàng" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Thêm nhóm hàng" Style="{StaticResource BtnPrimary}" Width="140" Click="BtnThem_Click"/>
            <Button Content="Sửa" Style="{StaticResource BtnSecondary}" Width="80" Margin="8,0,0,0" Click="BtnSua_Click"/>
            <Button Content="Xóa" Style="{StaticResource BtnDanger}" Width="80" Margin="8,0,0,0" Click="BtnXoa_Click"/>
            <Button Content="Làm mới" Style="{StaticResource BtnSecondary}" Width="90" Margin="8,0,0,0" Click="BtnLamMoi_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridNhomHang">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="100"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Ten}" Width="*"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
