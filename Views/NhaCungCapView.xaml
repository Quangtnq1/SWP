<UserControl x:Class="SWP.Views.NhaCungCapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Nhà cung cấp" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="+ Thêm nhà cung cấp" Style="{StaticResource BtnPrimary}" Width="150" Click="BtnThem_Click"/>
            <Button Content="Sửa" Style="{StaticResource BtnSecondary}" Width="80" Margin="8,0,0,0" Click="BtnSua_Click"/>
            <Button Content="Ngừng hoạt động" Style="{StaticResource BtnDanger}" Width="130" Margin="8,0,0,0" Click="BtnNgungHoatDong_Click"/>
            <Button Content="Làm mới" Style="{StaticResource BtnSecondary}" Width="90" Margin="8,0,0,0" Click="BtnLamMoi_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridNhaCungCap">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="80"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding Ten}" Width="*"/>
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="110"/>
                <DataGridTextColumn Header="Người liên hệ" Binding="{Binding NguoiLienHe}" Width="130"/>
                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding DangHoatDong}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
