<UserControl x:Class="SWP.Views.BaoCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Báo cáo" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Từ ngày" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DpTuNgay" Width="140" SelectedDateChanged="Loc_Changed"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DpDenNgay" Width="140" SelectedDateChanged="Loc_Changed"/>
            </StackPanel>
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="Nhập - Xuất - Tồn">
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Top" Content="Xuất CSV" Style="{StaticResource BtnSecondary}" Width="100"
                            HorizontalAlignment="Right" Margin="0,0,0,10" Click="BtnXuatCsvNhapXuatTon_Click"/>
                    <DataGrid x:Name="GridNhapXuatTon">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="90"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Ten}" Width="*"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="70"/>
                            <DataGridTextColumn Header="Tồn đầu kỳ" Binding="{Binding TonDauKy}" Width="100"/>
                            <DataGridTextColumn Header="Tổng nhập" Binding="{Binding TongNhap}" Width="100"/>
                            <DataGridTextColumn Header="Tổng xuất" Binding="{Binding TongXuat}" Width="100"/>
                            <DataGridTextColumn Header="Tồn cuối kỳ" Binding="{Binding TonCuoiKy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Thẻ kho">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CboSanPhamTheKho" Width="260" DisplayMemberPath="Ten" SelectionChanged="Loc_Changed"/>
                    </StackPanel>
                    <DataGrid x:Name="GridTheKho">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding SanPhamHienThi}" Width="180"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding LoaiGiaoDich}" Width="110"/>
                            <DataGridTextColumn Header="Số chứng từ" Binding="{Binding SoChungTu}" Width="140"/>
                            <DataGridTextColumn Header="Nhập" Binding="{Binding SoLuongNhap}" Width="80"/>
                            <DataGridTextColumn Header="Xuất" Binding="{Binding SoLuongXuat}" Width="80"/>
                            <DataGridTextColumn Header="Tồn lũy kế" Binding="{Binding TonLuyKe}" Width="90"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Chi phí theo bộ phận">
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Top" Content="Xuất CSV" Style="{StaticResource BtnSecondary}" Width="100"
                            HorizontalAlignment="Right" Margin="0,0,0,10" Click="BtnXuatCsvChiPhi_Click"/>
                    <DataGrid x:Name="GridChiPhi">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bộ phận" Binding="{Binding BoPhan}" Width="200"/>
                            <DataGridTextColumn Header="Nhóm hàng" Binding="{Binding NhomHang}" Width="200"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Hàng dưới định mức">
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Top" Content="Xuất CSV" Style="{StaticResource BtnSecondary}" Width="100"
                            HorizontalAlignment="Right" Margin="0,0,0,10" Click="BtnXuatCsvHangDuoiDinhMuc_Click"/>
                    <DataGrid x:Name="GridHangDuoiDinhMuc">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="90"/>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Ten}" Width="*"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="80"/>
                            <DataGridTextColumn Header="Tồn hiện tại" Binding="{Binding TonKho}" Width="100"/>
                            <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding TonToiThieu}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
