<UserControl x:Class="SWP.Views.PhieuXuatListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Phiếu xuất kho" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="BtnLapPhieuMoi" Content="+ Lập phiếu mới" Style="{StaticResource BtnPrimary}" Width="150" Click="BtnLapPhieuMoi_Click"/>
            <Button Content="Xem chi tiết" Style="{StaticResource BtnSecondary}" Width="110" Margin="8,0,0,0" Click="BtnXemChiTiet_Click"/>
            <Button x:Name="BtnDuyet" Content="Duyệt" Style="{StaticResource BtnSuccess}" Width="90" Margin="8,0,0,0" Click="BtnDuyet_Click"/>
            <Button x:Name="BtnTuChoiHuy" Content="Từ chối / Hủy" Style="{StaticResource BtnDanger}" Width="120" Margin="8,0,0,0" Click="BtnTuChoiHuy_Click"/>
            <Button Content="Làm mới" Style="{StaticResource BtnSecondary}" Width="90" Margin="8,0,0,0" Click="BtnLamMoi_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridPhieu" MouseDoubleClick="GridPhieu_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="140"/>
                <DataGridTextColumn Header="Ngày xuất" Binding="{Binding NgayXuat, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Loại xuất" Binding="{Binding LoaiXuat}" Width="100"/>
                <DataGridTextColumn Header="Bộ phận nhận" Binding="{Binding BoPhan.Ten}" Width="180"/>
                <DataGridTextColumn Header="Người nhận" Binding="{Binding NguoiNhan}" Width="130"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0}}" Width="110"/>
                <DataGridTextColumn Header="Người lập" Binding="{Binding NguoiLap.HoTen}" Width="120"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
