<Window x:Class="SWP.Views.NhaCungCapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhà cung cấp" Height="640" Width="420"
        WindowStartupLocation="CenterOwner" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTieuDe" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Mã nhà cung cấp" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtMa" Margin="0,0,0,10"/>

        <TextBlock Text="Tên đầy đủ" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtTen" Margin="0,0,0,10"/>

        <TextBlock Text="Mã số thuế" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtMaSoThue" Margin="0,0,0,10"/>

        <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtDiaChi" Margin="0,0,0,10"/>

        <TextBlock Text="Điện thoại" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtDienThoai" Margin="0,0,0,10"/>

        <TextBlock Text="Người liên hệ" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtNguoiLienHe" Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkDangHoatDong" Content="Đang hoạt động" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnHuy_Click"/>
            <Button Content="Lưu" Style="{StaticResource BtnPrimary}" Width="90" Click="BtnLuu_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
