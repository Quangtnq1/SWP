<Window x:Class="SWP.Views.SanPhamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm" Height="700" Width="420"
        WindowStartupLocation="CenterOwner" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTieuDe" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Mã sản phẩm" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtMa" Margin="0,0,0,10"/>

        <TextBlock Text="Tên sản phẩm" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtTen" Margin="0,0,0,10"/>

        <TextBlock Text="Nhóm hàng" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CboNhomHang" DisplayMemberPath="Ten" Margin="0,0,0,10"/>

        <TextBlock Text="Đơn vị tính" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtDonViTinh" Margin="0,0,0,10"/>

        <TextBlock Text="Giá (dùng chung cho cả nhập lẫn xuất)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtGia" Margin="0,0,0,10"/>

        <TextBlock Text="Tồn tối thiểu" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtTonToiThieu" Margin="0,0,0,10"/>

        <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtGhiChu" Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkDangSuDung" Content="Đang sử dụng" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnHuy_Click"/>
            <Button Content="Lưu" Style="{StaticResource BtnPrimary}" Width="90" Click="BtnLuu_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
