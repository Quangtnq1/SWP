<Window x:Class="SWP.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Height="380" Width="380"
        WindowStartupLocation="CenterOwner" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock Text="Đổi mật khẩu" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="TxtMatKhauCu" Margin="0,0,0,12"/>

        <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="TxtMatKhauMoi" Margin="0,0,0,12"/>

        <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="TxtMatKhauMoiNhacLai" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnHuy_Click"/>
            <Button Content="Xác nhận" Style="{StaticResource BtnPrimary}" Width="90" Click="BtnXacNhan_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
