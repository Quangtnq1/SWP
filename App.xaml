<Application x:Class="SWP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SWP"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Bảng màu dùng chung ===== -->
            <SolidColorBrush x:Key="ColorPrimary" Color="#2563EB"/>
            <SolidColorBrush x:Key="ColorPrimaryDark" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="ColorDanger" Color="#DC2626"/>
            <SolidColorBrush x:Key="ColorDangerDark" Color="#B91C1C"/>
            <SolidColorBrush x:Key="ColorSuccess" Color="#16A34A"/>
            <SolidColorBrush x:Key="ColorSuccessDark" Color="#15803D"/>
            <SolidColorBrush x:Key="ColorWarning" Color="#D97706"/>
            <SolidColorBrush x:Key="ColorBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ColorSidebar" Color="#111827"/>
            <SolidColorBrush x:Key="ColorSidebarHover" Color="#1F2937"/>
            <SolidColorBrush x:Key="ColorBorder" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="ColorText" Color="#111827"/>
            <SolidColorBrush x:Key="ColorTextMuted" Color="#6B7280"/>
            <SolidColorBrush x:Key="ColorWhite" Color="#FFFFFF"/>

            <!-- ===== Nút bấm mặc định (nền xanh) ===== -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorPrimaryDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Nút phụ (viền, nền trắng) ===== -->
            <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorBg}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Nút nguy hiểm (từ chối/hủy/xóa) ===== -->
            <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorDangerDark}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Nút thành công (duyệt) ===== -->
            <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                <Setter Property="Background" Value="{StaticResource ColorSuccess}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ColorSuccessDark}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Ô nhập liệu ===== -->
            <Style x:Key="InputBox" TargetType="Control">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBox}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource InputBox}"/>
            <Style TargetType="DatePicker" BasedOn="{StaticResource InputBox}"/>

            <!-- ===== Nhãn tiêu đề trường nhập liệu ===== -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- ===== Tiêu đề màn hình ===== -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

            <!-- ===== DataGrid dùng chung ===== -->
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="ColumnHeaderHeight" Value="36"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F9FAFB"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextMuted}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Nút menu sidebar ===== -->
            <Style x:Key="SidebarButton" TargetType="Button">
                <Setter Property="Foreground" Value="#D1D5DB"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorSidebarHover}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Thẻ trạng thái chứng từ (chip) ===== -->
            <Style x:Key="StatusChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
