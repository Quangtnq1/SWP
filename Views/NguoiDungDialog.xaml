<Window x:Class="SWP.Views.NguoiDungDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Người dùng" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTieuDe" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtTenDangNhap" Margin="0,0,0,10"/>

        <TextBlock Text="Họ tên" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtHoTen" Margin="0,0,0,10"/>

        <TextBlock x:Name="LblVaiTro" Text="Vai trò" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CboVaiTro" Margin="0,0,0,10"/>

        <TextBlock Text="Điện thoại" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtDienThoai" Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkDangHoatDong" Content="Đang hoạt động" Margin="0,0,0,10"/>

        <StackPanel x:Name="PanelMatKhauMoi">
            <TextBlock Text="Mật khẩu ban đầu" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtMatKhauMoi" Margin="0,0,0,16"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnHuy_Click"/>
            <Button Content="Lưu" Style="{StaticResource BtnPrimary}" Width="90" Click="BtnLuu_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
