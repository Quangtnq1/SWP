<UserControl x:Class="SWP.Views.TheKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock Text="Thẻ kho" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Sản phẩm" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboSanPham" Width="280" DisplayMemberPath="Ten" SelectionChanged="TimKiem_Changed"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Từ ngày" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DpTuNgay" Width="140" SelectedDateChanged="TimKiem_Changed"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Đến ngày" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DpDenNgay" Width="140" SelectedDateChanged="TimKiem_Changed"/>
            </StackPanel>
        </StackPanel>

        <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14" DockPanel.Dock="Top"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtMaSanPham" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtTenSanPham"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridKetQua">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding SanPhamHienThi}" Width="200"/>
                <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding LoaiGiaoDich}" Width="110"/>
                <DataGridTextColumn Header="Số chứng từ" Binding="{Binding SoChungTu}" Width="140"/>
                <DataGridTextColumn Header="Nhập" Binding="{Binding SoLuongNhap}" Width="90"/>
                <DataGridTextColumn Header="Xuất" Binding="{Binding SoLuongXuat}" Width="90"/>
                <DataGridTextColumn Header="Tồn lũy kế" Binding="{Binding TonLuyKe}" Width="100"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
