<Window x:Class="SWP.Views.PhieuXuatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu xuất kho" Height="640" Width="800"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTieuDe" Grid.Row="0" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Ngày xuất" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DpNgayXuat"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Loại xuất" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboLoaiXuat"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Bộ phận nhận" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CboBoPhan" DisplayMemberPath="Ten"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Người nhận" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtNguoiNhan"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Lý do xuất" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtLyDoXuat"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource ColorBg}" CornerRadius="6" Padding="12" Margin="0,0,0,10" x:Name="PanelThemDong">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="260" Margin="0,0,8,0">
                    <TextBlock Text="Sản phẩm" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CboSanPham" DisplayMemberPath="Ten"/>
                </StackPanel>
                <StackPanel Width="120" Margin="0,0,8,0">
                    <TextBlock Text="SL yêu cầu" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtSoLuongYeuCau"/>
                </StackPanel>
                <Button Content="+ Thêm vào phiếu" Style="{StaticResource BtnSecondary}" Width="130" VerticalAlignment="Bottom" Click="BtnThemDong_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridChiTiet" Grid.Row="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding SanPham.Ten}" Width="220"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuongYeuCau}" Width="100"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0" x:Name="PanelXoaDong">
            <Button Content="Xóa dòng đã chọn" Style="{StaticResource BtnDanger}" Width="140" Click="BtnXoaDong_Click"/>
        </StackPanel>

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Đơn giá/Thành tiền được điền tự động khi kế toán duyệt phiếu." FontStyle="Italic"
                       Foreground="{StaticResource ColorTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Đóng" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,8,0" Click="BtnDong_Click"/>
                <Button x:Name="BtnLuu" Content="Lưu phiếu" Style="{StaticResource BtnPrimary}" Width="110" Click="BtnLuu_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
